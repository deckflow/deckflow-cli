{
  "name": "@deckflow/deckflow-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "DeckFlow command line client for DeckBase",
  "repository": "https://github.com/deckflow/deckflow-cli.git",
  "bin": {
    "deckflow": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "packageManager": "pnpm@11.21.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "contracts": "node scripts/contracts.mjs",
    "typecheck": "pnpm contracts && tsc --noEmit",
    "test": "pnpm build && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "node scripts/pack-check.mjs",
    "ci:check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm pack:check"
  },
  "devDependencies": {
    "@deckflow/deckbase-sdk": "file:../deckbase/dist-sdk",
    "@types/node": "22",
    "@types/proper-lockfile": "4.1.4",
    "commander": "13.1.0",
    "esbuild": "latest",
    "open": "10.2.0",
    "prettier": "latest",
    "proper-lockfile": "4.1.2",
    "typescript": "7.0.2",
    "vitest": "latest"
  }
}
